{
  "name": "@tessel-la/roboboy-microduck-control-panel",
  "version": "1.0.0",
  "description": "Optional Robo-Boy control panel for the Microduck locomotion simulation",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "roboboy.panel.json",
    "README.md",
    "behavior-trees",
    "examples",
    "LICENSE"
  ],
  "exports": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "integrity": "node scripts/update-integrity.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "validate:artifact": "node scripts/validate-artifact.mjs",
    "validate": "npm run typecheck && npm test && npm run validate:artifact",
    "release:prepare": "npm run typecheck && npm test && npm run integrity && npm run validate:artifact"
  },
  "devDependencies": {
    "@tessel-la/roboboy-panel-sdk": "https://github.com/tessel-la/robo-boy/releases/download/panel-sdk-v2.2.0/tessel-la-roboboy-panel-sdk-2.2.0.tgz",
    "jsdom": "^25.0.1",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=22"
  }
}
